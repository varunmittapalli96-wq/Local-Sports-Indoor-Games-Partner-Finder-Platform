# ==============================================================================
# PlayNear Client - Environment Variables
# ==============================================================================

# Backend REST API endpoint (must end with /api/v1)
# Development: http://localhost:5000/api/v1
# Production:  https://your-server-app.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Real-time WebSocket server endpoint (optional, defaults to base of NEXT_PUBLIC_API_URL)
# Development: http://localhost:5000
# Production:  https://your-server-app.onrender.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
