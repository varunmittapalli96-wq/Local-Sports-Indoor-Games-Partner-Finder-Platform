# PlayNear Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Database URI (supports Atlas, local Docker, or local mongod)
# If left empty or unable to connect in development, an embedded in-memory MongoDB will start automatically for zero-config demoing
MONGODB_URI=mongodb://localhost:27017/playnear_platform_db

# Authentication
JWT_SECRET=super_secret_playnear_jwt_key_replace_in_production_32chars!
JWT_EXPIRES_IN=7d

# Email Configuration (Nodemailer - console or ethereal fallback used if empty)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@playnear.local

# Frontend Public Config
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_MAP_DEFAULT_LAT=12.9716
NEXT_PUBLIC_MAP_DEFAULT_LNG=77.5946
