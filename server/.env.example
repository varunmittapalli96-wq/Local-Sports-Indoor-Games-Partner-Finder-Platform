# ==============================================================================
# PlayNear Server - Environment Variables
# ==============================================================================

# Server Network Configuration (Render automatically injects PORT)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database URI (replace <password> and <cluster> with your Atlas details)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin_user:YourStrongPassword123@cluster0.abcde.mongodb.net/playnear_platform_db?retryWrites=true&w=majority

# JWT Authentication Secret (must be at least 32 characters in production)
JWT_SECRET=production_random_secret_string_minimum_32_characters_here_12345
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL(s) - Comma-separated for multiple origins
# Example for Render: https://playnear-app.onrender.com
# Example with localhost: https://playnear-app.onrender.com,http://localhost:3000
CLIENT_URL=https://your-client-app.onrender.com

# Initial Administrator Credentials (used when running 'npm run seed')
ADMIN_EMAIL=admin@playnear.com
ADMIN_PASSWORD=AdminPass123!

# Email Service (Optional: for verification and password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="PlayNear Sports" <no-reply@playnear.com>
